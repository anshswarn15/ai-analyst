# ---- Pick ONE provider and set its key. All are used through the OpenAI-compatible API. ----
# gemini  -> free tier available: https://aistudio.google.com/apikey
# groq    -> free tier available: https://console.groq.com/keys
# openai | anthropic | ollama (local, no key needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Or use LLM_API_KEY with any OpenAI-compatible provider / LLM_BASE_URL.
# LLM_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides (model names change often - check your provider's docs)
# Groq default: openai/gpt-oss-20b (override only when needed)
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.1

# ---- App limits ----
MAX_UPLOAD_MB=25
MAX_FILES_PER_SESSION=10
SESSION_TTL_MINUTES=120
MAX_AGENT_STEPS=2
SQL_ROW_LIMIT=500
SQL_TIMEOUT_S=10
LOG_LEVEL=INFO

# ---- Account login (APP_USERNAME/PASSWORD bootstrap the first account) ----
# APP_USERNAME=demo
# APP_PASSWORD=choose-a-long-random-password
AUTH_ENABLED=false
ALLOW_SIGNUP=false
AUTH_COOKIE_SECURE=false  # set true behind HTTPS, e.g. Render
# SESSION_SECRET=replace-with-a-long-random-string-before-public-deployment
# AUTH_DB_PATH=data/auth.db  # mount persistent storage here for a public deployment
